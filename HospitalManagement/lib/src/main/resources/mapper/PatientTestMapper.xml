<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.hospitalmanagement.mapper.IPatientTestMapper">

    <resultMap id="patientTestResultMap"
               type="com.crimsonlogic.hospitalmanagement.model.PatientTest">

        <id property="patientTestId"
            column="patient_test_id"/>

        <result property="patientId"
                column="patient_id"/>

        <result property="testId"
                column="test_id"/>

        <result property="testDate"
                column="test_date"/>

        <result property="status"
                column="status"/>

        <result property="charge"
                column="charge"/>

    </resultMap>


    <insert id="addPatientTest"
            parameterType="com.crimsonlogic.hospitalmanagement.model.PatientTest">

        INSERT INTO patient_test
        (
            patient_test_id,
            patient_id,
            test_id,
            test_date,
            status,
            charge
        )
        VALUES
        (
            #{patientTestId},
            #{patientId},
            #{testId},
            #{testDate},
            #{status},
            #{charge}
        )

    </insert>


    <select id="getPatientTestById"
            resultMap="patientTestResultMap">

        SELECT
            patient_test_id,
            patient_id,
            test_id,
            test_date,
            status,
            charge
        FROM patient_test
        WHERE patient_test_id = #{patientTestId}

    </select>


    <select id="getPatientTestsByPatientId"
            resultMap="patientTestResultMap">

        SELECT
            patient_test_id,
            patient_id,
            test_id,
            test_date,
            status,
            charge
        FROM patient_test
        WHERE patient_id = #{patientId}
        ORDER BY test_date DESC

    </select>


    <select id="getAllPatientTests"
            resultMap="patientTestResultMap">

        SELECT
            patient_test_id,
            patient_id,
            test_id,
            test_date,
            status,
            charge
        FROM patient_test
        ORDER BY test_date DESC

    </select>


    <update id="updateTestStatus">

        UPDATE patient_test

        SET status = #{status}

        WHERE patient_test_id = #{patientTestId}

    </update>

</mapper>