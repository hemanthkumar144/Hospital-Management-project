<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.hospitalmanagement.mapper.IPaymentMapper">


    <!-- =====================================================
         PAYMENT RESULT MAP
         ===================================================== -->

    <resultMap id="paymentResultMap"
               type="com.crimsonlogic.hospitalmanagement.model.Payment">

        <!-- Payment fields -->

        <id property="paymentId"
            column="payment_id"/>

        <result property="paymentDate"
                column="payment_date"/>

        <result property="paymentType"
                column="payment_type"/>

        <result property="amount"
                column="amount"/>

        <result property="status"
                column="status"/>

        <result property="active"
                column="active"/>


        <!-- =================================================
             BILL
             ================================================= -->

        <association property="bill"
                     javaType="com.crimsonlogic.hospitalmanagement.model.Bill">

            <id property="billId"
                column="bill_id"/>


            <!-- =============================================
                 PATIENT INSIDE BILL
                 ============================================= -->

            <association property="patient"
                         javaType="com.crimsonlogic.hospitalmanagement.model.Patient">

                <id property="patientId"
                    column="patient_id"/>

            </association>

        </association>

    </resultMap>


    <!-- =====================================================
         ADD PAYMENT
         ===================================================== -->

    <insert id="addPayment">

        INSERT INTO payment
        (
            payment_id,
            bill_id,
            payment_date,
            payment_type,
            amount,
            status,
            active
        )

        VALUES
        (
            #{paymentId},
            #{bill.billId},
            #{paymentDate},
            #{paymentType},
            #{amount},
            #{status},
            #{active}
        )

    </insert>


    <!-- =====================================================
         GET PAYMENT BY ID
         ===================================================== -->

    <select id="getPaymentById"
            resultMap="paymentResultMap">

        SELECT
            p.payment_id,
            p.payment_date,
            p.payment_type,
            p.amount,
            p.status,
            p.active,

            b.bill_id,
            b.patient_id

        FROM payment p

        JOIN bill b
            ON p.bill_id = b.bill_id

        WHERE p.payment_id = #{paymentId}

    </select>


    <!-- =====================================================
         GET ALL PAYMENTS
         ===================================================== -->

    <select id="getAllPayments"
            resultMap="paymentResultMap">

        SELECT
            p.payment_id,
            p.payment_date,
            p.payment_type,
            p.amount,
            p.status,
            p.active,

            b.bill_id,
            b.patient_id

        FROM payment p

        JOIN bill b
            ON p.bill_id = b.bill_id

        WHERE p.active = TRUE

        ORDER BY p.payment_date

    </select>


    <!-- =====================================================
         GET MAX PAYMENT NUMBER
         ===================================================== -->

    <select id="getMaxPaymentNumber"
            resultType="java.lang.Integer">

        SELECT MAX(
            CAST(
                SUBSTRING(payment_id, 4)
                AS UNSIGNED
            )
        )

        FROM payment

    </select>

</mapper>