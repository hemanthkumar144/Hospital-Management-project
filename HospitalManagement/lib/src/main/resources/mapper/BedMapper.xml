<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.hospitalmanagement.mapper.IBedMapper">


    <!-- =====================================================
         BED RESULT MAP
         ===================================================== -->

    <resultMap id="bedResultMap"
               type="com.crimsonlogic.hospitalmanagement.model.Bed">

        <id property="bedId"
            column="bed_id"/>

        <result property="availability"
                column="availability"/>

        <result property="active"
                column="active"/>


        <!-- =================================================
             WARD ASSOCIATION
             ================================================= -->

        <association property="ward"
                     javaType="com.crimsonlogic.hospitalmanagement.model.Ward">

            <id property="wardId"
                column="ward_id"/>

            <result property="wardName"
                    column="ward_name"/>

            <result property="wardType"
                    column="ward_type"/>

            <result property="bedCharge"
                    column="bed_charge"/>

            <result property="active"
                    column="ward_active"/>

        </association>


        <!-- =================================================
             PATIENT ASSOCIATION
             ================================================= -->

        <association property="patient"
                     javaType="com.crimsonlogic.hospitalmanagement.model.Patient">

            <id property="patientId"
                column="patient_id"/>

            <result property="patientName"
                    column="patient_name"/>

            <result property="age"
                    column="patient_age"/>

            <result property="gender"
                    column="patient_gender"/>

            <result property="phone"
                    column="patient_phone"/>

            <result property="active"
                    column="patient_active"/>

        </association>

    </resultMap>


    <!-- =====================================================
         ADD BED
         ===================================================== -->

    <insert id="addBed">

        INSERT INTO bed
        (
            bed_id,
            ward_id,
            availability,
            patient_id,
            active
        )
        VALUES
        (
            #{bedId},
            #{ward.wardId},
            #{availability},
            #{patient.patientId,jdbcType=VARCHAR},
            #{active}
        )

    </insert>


    <!-- =====================================================
         GET BED BY ID
         ===================================================== -->

    <select id="getBedById"
            resultMap="bedResultMap">

        SELECT

            b.bed_id,
            b.ward_id,
            b.availability,
            b.patient_id,
            b.active,

            w.ward_name,
            w.ward_type,
            w.bed_charge,
            w.active AS ward_active,

            p.patient_name,
            p.age AS patient_age,
            p.gender AS patient_gender,
            p.phone AS patient_phone,
            p.active AS patient_active

        FROM bed b

        JOIN ward w
            ON b.ward_id = w.ward_id

        LEFT JOIN patient p
            ON b.patient_id = p.patient_id

        WHERE b.bed_id = #{bedId}

          AND b.active = TRUE

    </select>


    <!-- =====================================================
         GET ALL ACTIVE BEDS
         ===================================================== -->

    <select id="getAllBeds"
            resultMap="bedResultMap">

        SELECT

            b.bed_id,
            b.ward_id,
            b.availability,
            b.patient_id,
            b.active,

            w.ward_name,
            w.ward_type,
            w.bed_charge,
            w.active AS ward_active,

            p.patient_name,
            p.age AS patient_age,
            p.gender AS patient_gender,
            p.phone AS patient_phone,
            p.active AS patient_active

        FROM bed b

        JOIN ward w
            ON b.ward_id = w.ward_id

        LEFT JOIN patient p
            ON b.patient_id = p.patient_id

        WHERE b.active = TRUE

        ORDER BY b.bed_id

    </select>


    <!-- =====================================================
         UPDATE BED
         ===================================================== -->

    <update id="updateBed">

        UPDATE bed

        SET
            ward_id = #{ward.wardId},
            availability = #{availability},
            patient_id = #{patient.patientId,jdbcType=VARCHAR}

        WHERE bed_id = #{bedId}

          AND active = TRUE

    </update>


    <!-- =====================================================
         SOFT DELETE BED
         ===================================================== -->

    <update id="deleteBed">

        UPDATE bed

        SET active = FALSE

        WHERE bed_id = #{bedId}

          AND active = TRUE

    </update>


</mapper>